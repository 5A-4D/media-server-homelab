[Unit]
Description=Media homelab isolated downloads (example paths)
Requires=docker.service
After=docker.service network-online.target tailscaled.service
Wants=network-online.target tailscaled.service
RequiresMountsFor=/srv/example-media-data /opt/media-homelab/state

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/media-homelab
ExecStart=/usr/bin/docker compose --env-file /opt/media-homelab/.env -f examples/compose.downloads.yaml up --detach
ExecStop=/usr/bin/docker compose --env-file /opt/media-homelab/.env -f examples/compose.downloads.yaml down
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
